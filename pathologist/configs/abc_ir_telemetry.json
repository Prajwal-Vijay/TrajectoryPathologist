{
  "metrics": {
    "action_discontinuity": {
      "ignored_dimensions": []
    }
  },
  "selector": {
    "surprise_flood": {
      "aggregate_metric_name": "ecod_aggregate_score",
      "smoothing_window": 10,
      "gamma": 0.5,
      "ranking": "persistence",
      "max_proposals": 5
    }
  },
  "surprise": {
    "source_metrics": [
      "action_discontinuity",
      "motion_smoothness",
      "eef_translational_stalling",
      "eef_rotational_stalling",
      "eef_translational_jerk",
      "eef_angular_jerk"
    ],
    "aggregation_reduction": "sum"
  }
}
