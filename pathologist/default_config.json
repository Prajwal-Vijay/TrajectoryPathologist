{
  "metrics": {
    "max_events_per_metric": 20,
    "timestamp_regularity": {
      "gap_mad_multiplier": 3.0,
      "gap_median_multiplier": 1.0,
      "high_gap_multiplier": 2.0
    },
    "action_range_saturation": {
      "saturation_tolerance": 1e-6,
      "low_fraction": 0.01,
      "medium_fraction": 0.05,
      "high_fraction": 0.15
    },
    "action_discontinuity": {
      "ignored_dimensions": [14, 15]
    },
    "action_distribution_entropy": {
      "entropy_bins": 10,
      "low_entropy_threshold": 0.15,
      "high_entropy_threshold": 0.95
    },
    "motion_smoothness": {},
    "velocity_spike": {},
    "stalling": {},
    "eef_linear_velocity_spike": {},
    "eef_angular_velocity_spike": {},
    "eef_translational_stalling": {},
    "eef_rotational_stalling": {},
    "eef_translational_jerk": {},
    "eef_angular_jerk": {},
    "force_norm": {},
    "gripper_aperture_speed": {},
    "audio_spectral_flux": {
      "sample_rate_hz": 16000,
      "window_ms": 25,
      "hop_ms": 10,
      "mel_bins": 64,
      "min_frequency_hz": 50,
      "max_frequency_hz": 8000
    },
    "visual_flow": {
      "camera_names": ["head"],
      "frame_stride": 2,
      "resize": [128, 128],
      "spatial_aggregation": "mean",
      "robot_masking": {
        "enabled": false,
        "prompt": "robot arm. robot gripper.",
        "dino_model_id": "IDEA-Research/grounding-dino-tiny",
        "sam2_model_id": "facebook/sam2.1-hiera-tiny",
        "box_threshold": 0.35,
        "text_threshold": 0.25,
        "mask_threshold": 0.0,
        "dilation_px": 8,
        "duplicate_iou_threshold": 0.8,
        "chunk_size_frames": 20,
        "device": "auto"
      }
    },
    "visual_patch_novelty": {
      "enabled": true,
      "camera_names": ["head"],
      "model_id": "facebook/dinov2-small",
      "sample_period_sec": 0.5,
      "local_match_radius": 2,
      "top_fraction": 0.02,
      "batch_size": 16,
      "device": "auto"
    },
    "gripper_transition": {
      "gripper_binary_threshold": 0.5,
      "low_state_label": "closed",
      "high_state_label": "open"
    },
    "gripper_chatter": {
      "gripper_binary_threshold": 0.5,
      "chatter_bin_steps": 10,
      "min_chatter_rate": 2.0,
      "min_chatter_transitions": 4,
      "medium_percentile": 95,
      "high_percentile": 99
    }
  },
  "selector": {
    "frame_stride_within_window": 1,
    "visual_context_sec": 0.5,
    "max_frames_per_camera": 10,
    "metric_packet_context_steps": 10,
    "surprise_flood": {
      "aggregate_metric_name": "ecod_aggregate_score",
      "smoothing_window": 10,
      "gamma": 0.5,
      "ranking": "area",
      "max_proposals": 5
    }
  },
  "robofac_qa": {
    "kite_flow": {
      "frame_stride": 2,
      "nms_radius": 5,
      "resize_width": 128,
      "resize_height": 128
    }
  },
  "reassemble": {
    "robot_downsample_hz": 50.0,
    "camera_names": ["hama1", "hama2", "hand"],
    "include_event_camera": false,
    "extract_frames": true,
    "segment_level": "both",
    "top_k": 5,
    "metrics": {
      "visual_flow": {
        "camera_names": ["hama1", "hama2", "hand"],
        "frame_stride": 2,
        "resize": [128, 128],
        "spatial_aggregation": "mean"
      },
      "visual_patch_novelty": {
        "camera_names": ["hama1", "hama2", "hand"]
      }
    }
  },
  "surprise": {
    "enabled": true,
    "source_metrics": [
      "action_discontinuity",
      "motion_smoothness",
      "velocity_spike",
      "stalling",
      "eef_linear_velocity_spike",
      "eef_angular_velocity_spike",
      "eef_translational_stalling",
      "eef_rotational_stalling",
      "eef_translational_jerk",
      "eef_angular_jerk",
      "gripper_aperture_speed",
      "visual_flow",
      "visual_patch_novelty",
      "audio_spectral_flux"
    ],
    "aggregate_metric_name": "ecod_aggregate_score",
    "aggregation_reduction": "sum",
    "score_tail_overrides": {
      "stalling": "left",
      "eef_translational_stalling": "left",
      "eef_rotational_stalling": "left",
      "visual_patch_novelty": "right"
    },
    "skewness_sign_overrides": {
      "stalling": -1
    },
    "epsilon": 1e-12,
    "plot": {
      "enabled": true,
      "output_dir_name": "ecod_score_plots"
    }
  },
  "labeling": {
    "max_events_to_label": 30,
    "openai_model": null
  }
}
