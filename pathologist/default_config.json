      "high_gap_multiplier": 2.0
    },
    "action_range_saturation": {
      "saturation_tolerance": 1e-6,
      "low_fraction": 0.01,
      "medium_fraction": 0.05,
      "high_fraction": 0.15
    },
    "action_discontinuity": {
      "medium_percentile": 95,
      "high_percentile": 99,
      "robust_medium_mad_multiplier": 3.0,
      "robust_high_mad_multiplier": 6.0,
      "min_action_delta": 0.0,
      "ignored_dimensions": [14, 15]
    },
    "action_distribution_entropy": {
      "entropy_bins": 10,
      "low_entropy_threshold": 0.15,
      "high_entropy_threshold": 0.95
    },
    "motion_smoothness": {
      "medium_percentile": 95,
      "high_percentile": 99,
      "robust_medium_mad_multiplier": 3.0,
      "robust_high_mad_multiplier": 6.0,
      "max_tolerable_jerk": 0.05,
      "numerical_zero_jerk_norm": 1e-9,
      "min_jerk_norm": 0.0
    },
    "velocity_spike": {
      "medium_percentile": 95,
      "high_percentile": 99,
      "robust_medium_mad_multiplier": 3.0,
      "robust_high_mad_multiplier": 6.0,
      "min_velocity_norm": 0.0,
      "min_region_duration_sec": 0.0
    },
    "stalling": {
