{
  "metrics": {
    "max_events_per_metric": 20,
    "timestamp_regularity": {
      "gap_mad_multiplier": 3.0,
      "gap_median_multiplier": 1.0,
      "high_gap_multiplier": 2.0
    },
    "action_range_saturation": {
      "saturation_tolerance": 1e-6,
      "low_fraction": 0.01,
      "medium_fraction": 0.05,
      "high_fraction": 0.15
    },
    "action_discontinuity": {
      "ignored_dimensions": [14, 15]
    },
    "action_distribution_entropy": {
      "entropy_bins": 10,
      "low_entropy_threshold": 0.15,
      "high_entropy_threshold": 0.95
    },
    "motion_smoothness": {},
    "velocity_spike": {},
    "stalling": {},
    "visual_flow": {
      "camera_names": ["head"],
      "frame_stride": 2,
      "resize": [128, 128]
    },
    "gripper_transition": {
      "gripper_binary_threshold": 0.5,
      "low_state_label": "closed",
      "high_state_label": "open"
    },
    "gripper_chatter": {
      "gripper_binary_threshold": 0.5,
      "chatter_bin_steps": 10,
      "min_chatter_rate": 2.0,
      "min_chatter_transitions": 4,
      "medium_percentile": 95,
      "high_percentile": 99
    }
  },
  "selector": {
    "frame_stride_within_window": 1,
    "visual_context_sec": 0.5,
    "max_frames_per_camera": 10,
    "metric_packet_context_steps": 10,
    "surprise_flood": {
      "aggregate_metric_name": "ecod_aggregate_score",
      "smoothing_window": 10,
      "gamma": 0.5,
      "max_proposals": 5
    }
  },
  "robofac_qa": {
    "kite_flow": {
      "frame_stride": 2,
      "nms_radius": 5,
      "resize_width": 128,
      "resize_height": 128
    }
  },
  "reassemble": {
    "robot_downsample_hz": 50.0,
    "camera_names": ["hand"],
    "include_event_camera": false,
    "extract_frames": true,
    "segment_level": "both",
    "top_k": 5,
    "metrics": {
      "visual_flow": {
        "camera_names": ["hand"],
        "frame_stride": 2,
        "resize": [128, 128]
      }
    }
  },
  "surprise": {
    "enabled": true,
    "source_metrics": [
      "action_discontinuity",
      "motion_smoothness",
      "velocity_spike",
      "stalling",
      "visual_flow"
    ],
    "aggregate_metric_name": "ecod_aggregate_score",
    "score_tail_overrides": {
      "stalling": "left"
    },
    "skewness_sign_overrides": {
      "stalling": -1
    },
    "epsilon": 1e-12,
    "plot": {
      "enabled": true,
      "output_dir_name": "ecod_score_plots"
    }
  },
  "labeling": {
    "max_events_to_label": 30,
    "openai_model": null
  }
}
