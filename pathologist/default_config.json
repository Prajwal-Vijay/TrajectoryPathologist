      "speed_median_fraction": 0.05,
      "low_fraction": 0.10,
      "medium_fraction": 0.20,
      "high_fraction": 0.40
    },
    "gripper_transition": {
      "gripper_binary_threshold": 0.5,
      "low_state_label": "closed",
      "high_state_label": "open"
    },
    "gripper_chatter": {
      "gripper_binary_threshold": 0.5,
      "chatter_bin_steps": 10,
      "min_chatter_rate": 2.0,
      "min_chatter_transitions": 4,
      "medium_percentile": 95,
      "high_percentile": 99
    }
